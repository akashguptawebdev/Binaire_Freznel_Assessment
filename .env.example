PORT=4000
WORKER_POOL_SIZE=4
WORKER_CHUNK_ROWS=1500
WORKER_CHUNK_TIMEOUT_MS=15000
WORKER_DEMO_DELAY_MS=220
QUEUE_CAPACITY=250
QUEUE_AGING_MS=12000
MAX_CONCURRENT_PROCESSES=4
RESULT_TTL_MS=900000
CLIENT_STALE_MS=45000
